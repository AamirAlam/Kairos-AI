# ── Kairos agent — production env (set these as Railway service variables) ───
# Never commit the filled-in version.

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# CoinMarketCap (also used as the CMC MCP key)
CMC_API_KEY=

# Trust Wallet Agent Kit
TWAK_ACCESS_ID=
TWAK_HMAC_SECRET=
AGENT_ID=
# Headless container has no OS keychain — twak falls back to this for signing.
TWAK_WALLET_PASSWORD=
# Base64 of your EXISTING funded wallet (~/.twak/wallet.json), restored to the
# volume on first boot so the agent keeps its registered address.
#   macOS:  base64 -i ~/.twak/wallet.json | pbcopy
#   Linux:  base64 -w0 ~/.twak/wallet.json
TWAK_WALLET_JSON_B64=

# BSC RPC
BSC_RPC_URL=https://bsc-dataseed1.binance.org

# Agent config
PORT=3001
DRAWDOWN_CAP=0.30
TRADE_PCT=0.10
MAX_TRADE_SIZE_BNB=0.5
DAILY_TRADE_LIMIT=4
# BNB is gas on BSC — keep at least this much USD of BNB unspent (no buys below it)
GAS_RESERVE_USD=0.10

# Position management
TAKE_PROFIT_PCT=0.06
STOP_LOSS_PCT=0.035
MAX_HOLD_HOURS=48
REQUIRE_HIGH_CONFIDENCE=true
TRADING_WINDOWS=0-3,13-16

# Database — set DATABASE_URL to use Railway Postgres (recommended for prod).
# In Railway, reference the Postgres service:  DATABASE_URL=${{Postgres.DATABASE_URL}}
# When DATABASE_URL is set, SQLite/DB_PATH is ignored and the volume only holds
# the twak wallet. If you omit DATABASE_URL it falls back to SQLite at DB_PATH.
DATABASE_URL=
# DB_PATH=/data/agent.db   # only used when DATABASE_URL is unset (SQLite fallback)
