# ── Kairos agent — production env (copy to agent/.env on the EC2 box) ────────
# Never commit the filled-in version. systemd reads this via EnvironmentFile.

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# CoinMarketCap (also used as the CMC MCP key)
CMC_API_KEY=

# Trust Wallet Agent Kit
TWAK_ACCESS_ID=
TWAK_HMAC_SECRET=
AGENT_ID=
# Headless server has no OS keychain — twak falls back to this for signing.
TWAK_WALLET_PASSWORD=

# BSC RPC
BSC_RPC_URL=https://bsc-dataseed1.binance.org

# Agent config
PORT=3001
DRAWDOWN_CAP=0.30
TRADE_PCT=0.10
MAX_TRADE_SIZE_BNB=0.5
DAILY_TRADE_LIMIT=4
# BNB is gas on BSC — keep at least this much USD of BNB unspent (no buys below it)
GAS_RESERVE_USD=0.10

# Position management
TAKE_PROFIT_PCT=0.06
STOP_LOSS_PCT=0.035
MAX_HOLD_HOURS=48
REQUIRE_HIGH_CONFIDENCE=true
TRADING_WINDOWS=0-3,13-16

# DB_PATH is injected by the systemd unit (-> /var/lib/kairos/agent.db).
# Set it here only if running the agent manually outside systemd.
# DB_PATH=/var/lib/kairos/agent.db
