# Public frontend config (NEXT_PUBLIC_* is exposed to the browser — no secrets here).
# Used by `next build` in production (locally and on Vercel). Override in the
# Vercel dashboard if the agent URL changes.

# Railway agent service (REST + WebSocket; wss:// is derived from this)
NEXT_PUBLIC_AGENT_URL=https://kairos-ai-production.up.railway.app

# Agent wallet shown in the header (links to BscScan)
NEXT_PUBLIC_AGENT_ADDRESS=0x644ae63803121De0fF3628db0B3f588E65759a1d
